@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

@model List<Notes>

<div class="card">
    <div class="card-header mt-3">
        <div class="row g-3">
            <div class="col-md-9">
                <h2>Notas</h2>
            </div>

            <div class="col-md-1">
                <h6>Crear Nota</h6>
                <a asp-action="CreateNotas"><i class="bi bi-plus-circle"></i></a>
            </div>
            <div class="col-md-2">
                <h6>Crear Categoria</h6>
                <a asp-action="CreateCategory"><i class="bi bi-plus-circle"></i></a>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <h4>Notas Disponibles</h4>
            </div>

            <div class="col-md-6">
                <form method="get" asp-action="IndexNotas">
                    <input type="text" name="filter" value="@ViewBag.Filter" class="form-control"/>
                    <button type="submit">Buscar</button>
                </form>
            </div>
        </div>
    </div>

    <div class="card-body">
        <table class="table table-bordered mt-3">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Topic</th>
                    <th>Descripcion</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Topic</td>
                        <td>@item.Description</td>
                        <td>@item.Date</td>
                        <td>@(item.Category.Name)</td>
                        <td>
                            <form asp-action="Delete" method="post">
                                <button class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>