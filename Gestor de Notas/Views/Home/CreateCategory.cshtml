@model Category
@{
    ViewData["Title"] = "Crear Categoría";
}

<div class="page-title dark-background aos-init aos-animate" data-aos="fade" style="background-image: url(assets/img/travel/showcase-8.webp);">
    <div class="container position-relative">
        <h1>Crear categoría</h1>
        <p>Administra las categorías de notas.</p>
        <nav class="breadcrumbs">
            <ol>
                <li><a asp-controller="Home" asp-action="IndexNotas">Home</a></li>
                <li class="current">Create Category</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h2 class="m-0 font-weight-bold text-primary">Nueva Categoría</h2>
    </div>

    <div class="card-body">
        <form asp-action="CreateCategory" method="post" class="row g-3">
            <div class="col-md-12">
                <div class="form-floating">
                    <input asp-for="Name" class="form-control" />
                    <label asp-for="Name">Nombre</label>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <button class="btn btn-primary" type="submit">Guardar</button>
                <a asp-action="IndexNotas" class="btn btn-secondary">Regresar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}